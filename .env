APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://root:root@localhost:5432/radio_shuffle?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SIGNING_KEY=change-me-at-least-32-chars-long!!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=radio-shuffle
CORS_ALLOWED_ORIGINS=*
RUN_MIGRATIONS_ON_BOOT=false
MIGRATIONS_PATH=./db/migrations
